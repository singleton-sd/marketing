{
  "$schema": "./custom-domains.schema.json",
  "comment": "Company marketing custom domains under singletonsd.com",
  "zoneDomain": "singletonsd.com",
  "resourceGroup": "rg-ssd-marketing",
  "ttlSeconds": 300,
  "records": [
    {
      "name": "www",
      "type": "CNAME",
      "value": "yellow-bush-0894e2800.7.azurestaticapps.net"
    }
  ],
  "bindings": [
    {
      "kind": "swa",
      "resourceName": "ssd-mkt-prod-ae",
      "hostname": "www.singletonsd.com"
    },
    {
      "kind": "swa",
      "resourceName": "ssd-mkt-prod-ae",
      "hostname": "singletonsd.com"
    }
  ],
  "deploys": [
    {
      "name": "marketing",
      "vaultName": "ssd-global-kv-prod-ae",
      "secretName": "swa-marketing-deployment-token",
      "appLocation": "apps/marketing/dist"
    }
  ]
}
