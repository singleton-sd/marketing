{
  "name": "singleton-sd-marketing",
  "private": true,
  "description": "Singleton Software Development company marketing site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singleton-sd/marketing.git"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @singleton-sd/marketing dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "commitlint": "commitlint --edit",
    "release": "node ./scripts/release-changed.mjs",
    "release:ci": "node ./scripts/release-changed.mjs --ci",
    "changelog:check": "node ./scripts/check-client-changelogs.mjs",
    "changelog:test": "node --test ./scripts/client-changelog.test.mjs ./scripts/backfill-client-changelogs.test.mjs ./scripts/check-client-changelogs.test.mjs",
    "changelog:backfill": "node ./scripts/backfill-client-changelogs.mjs",
    "changelog:backfill:dry-run": "node ./scripts/backfill-client-changelogs.mjs --dry-run"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@release-it/conventional-changelog": "10.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "husky": "^9.1.7",
    "release-it": "^18.1.2",
    "semver": "^7.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
