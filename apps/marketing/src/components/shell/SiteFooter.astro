---
import Icon from '../ui/Icon.astro';
import { footerColumns, withBase } from '../../lib/nav';
import { LOGO_LIGHT, SITE_NAME } from '../../lib/site';

interface Props {
  blurb?: string;
}

const {
  blurb = 'Custom software, cloud on Azure, product engineering, and design systems.',
} = Astro.props;

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL || '/';
const homeHref = withBase('/', base);
---

{/* Inverse surface: text-fg-subtle fails AA on bg-bg-inverse (~1.3:1).
    Move muted copy to --ssd-color-text-inverse-subtle in a later tokens release. */}
<footer class="bg-bg-inverse text-fg-inverse">
  <div class="mx-auto max-w-content px-5 py-12 md:px-10 md:py-16">
    <div class="flex flex-col gap-12 lg:flex-row lg:justify-between">
      <div class="max-w-xs space-y-4">
        <a href={homeHref} class="inline-flex items-center no-underline" aria-label={SITE_NAME}>
          <img
            src={LOGO_LIGHT}
            alt=""
            width="32"
            height="32"
            class="size-8 shrink-0"
            decoding="async"
          />
        </a>
        <p class="m-0 text-caption text-fg-inverse">{blurb}</p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 sm:gap-16">
        {
          footerColumns.map((column) => (
            <div class="space-y-4">
              <p class="m-0 text-caption font-bold uppercase tracking-wide text-fg-inverse">
                {column.title}
              </p>
              <ul class="m-0 flex list-none flex-col gap-3 p-0">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={withBase(link.href, base)}
                      class="text-caption text-fg-inverse no-underline transition hover:text-accent"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-border-strong/40 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="m-0 text-caption text-fg-inverse">
        © {year} Singleton Software Development. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/singleton-sd"
          class="text-fg-inverse transition hover:text-accent"
          aria-label="GitHub"
        >
          <Icon name="github" size={20} />
        </a>
      </div>
    </div>
  </div>
</footer>
