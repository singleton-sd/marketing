---
interface Props {
  id: string;
  name?: string;
  label?: string;
  checked?: boolean;
  value?: string;
  required?: boolean;
  class?: string;
}

const {
  id,
  name = id,
  label = '',
  checked = false,
  value = 'on',
  required = false,
  class: className = '',
} = Astro.props;
---

<label class:list={['inline-flex cursor-pointer items-start gap-3 text-body-sm text-fg', className]}>
  <input
    id={id}
    name={name}
    type="checkbox"
    value={value}
    checked={checked}
    required={required}
    class="mt-0.5 size-4 shrink-0 rounded-sm border border-control accent-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-focus focus-visible:outline-focus"
  />
  <span>
    <slot>{label}</slot>
  </span>
</label>
