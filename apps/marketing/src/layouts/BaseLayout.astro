---
import '../styles/global.css';
import SiteFooter from '../components/shell/SiteFooter.astro';
import SiteHeader from '../components/shell/SiteHeader.astro';
import {
  FAVICON,
  ORGANIZATION_LOGO,
  SITE_NAME,
  SITE_ORIGIN,
  resolveOgImageUrl,
} from '../lib/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  theme?: 'light' | 'dark';
  showShell?: boolean;
}

const {
  title,
  description = '',
  ogImage,
  theme = 'light',
  showShell = true,
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const resolvedOgImage = resolveOgImageUrl(ogImage, Astro.site ?? undefined);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: SITE_NAME,
      url: SITE_ORIGIN,
      logo: ORGANIZATION_LOGO,
      sameAs: ['https://github.com/singleton-sd'],
    },
    {
      '@type': 'WebSite',
      name: SITE_NAME,
      url: SITE_ORIGIN,
    },
  ],
};
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description ? <meta name="description" content={description} /> : null}
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="manifest" href={FAVICON.manifest} />
    <link rel="apple-touch-icon" href={FAVICON.appleTouch} />
    <link rel="icon" type="image/png" sizes="32x32" href={FAVICON.png32} />
    <link rel="icon" type="image/png" sizes="16x16" href={FAVICON.png16} />
    <link rel="shortcut icon" href={FAVICON.shortcut} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    {description ? <meta property="og:description" content={description} /> : null}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description ? <meta name="twitter:description" content={description} /> : null}
    <meta name="twitter:image" content={resolvedOgImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-fg antialiased">
    {showShell ? <SiteHeader currentPath={currentPath} /> : null}
    <main class="flex-1">
      <slot />
    </main>
    {showShell ? <SiteFooter /> : null}
  </body>
</html>
