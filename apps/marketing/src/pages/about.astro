---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/marketing/Hero.astro';
import { getEntry } from 'astro:content';
import { appCta } from '../lib/nav';

const page = await getEntry('pages', 'about');
if (!page) {
  throw new Error('Missing content: pages/about');
}
const { Content } = await page.render();
const { title, description, ogImage, brand, headline, ctaLabel, ctaUrl } = page.data;
const primaryHref = ctaUrl ?? appCta.href;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <Hero
    eyebrow={brand ?? 'About'}
    headline={headline ?? 'Singleton Software Development'}
    primaryCta={{
      label: ctaLabel ?? appCta.label,
      href: primaryHref,
    }}
  >
    <div class="[&_p]:m-0 [&_p+p]:mt-3">
      <Content />
    </div>
  </Hero>
</BaseLayout>
