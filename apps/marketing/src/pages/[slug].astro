---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContainer from '../components/shell/PageContainer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const dedicated = new Set(['home', 'about', 'services', 'contact']);
  return pages
    .filter((entry) => !dedicated.has(entry.slug))
    .map((entry) => ({
      params: { slug: entry.slug },
      props: { page: entry },
    }));
}

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { Content } = await page.render();
const { title, description, ogImage, updated } = page.data;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <PageContainer narrow class="pb-16 pt-[clamp(2rem,8vh,4rem)]">
    <a
      class="mb-6 inline-block text-fg-muted no-underline hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      href="/"
    >
      ← Back to Singleton SD
    </a>
    <article class="prose-legal">
      <h1 class="mb-1 font-heading text-h1 font-bold tracking-tight text-fg">{title}</h1>
      {updated ? <p class="mb-8 text-body-sm text-fg-muted">Last updated: {updated}</p> : null}
      <Content />
    </article>
  </PageContainer>
</BaseLayout>
