# Public Cloudflare Turnstile site key (safe to expose in the browser).
# Do not put the secret key here. Leave empty locally to keep submit disabled.
# Cloudflare dummy always-pass key (tests only): 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=

# Lead intake endpoint. Default is the shared gateway route.
PUBLIC_LEADS_API_URL=https://api.singletonsd.com/v1/leads
