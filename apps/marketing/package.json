{
  "name": "@singleton-sd/marketing",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-tokens": "node ./scripts/copy-token-css.mjs",
    "dev": "node ./scripts/copy-token-css.mjs && astro dev",
    "build": "node ./scripts/copy-token-css.mjs && astro build",
    "preview": "astro preview",
    "lint": "astro check",
    "test": "node --test src/lib/site.test.mjs src/lib/with-base.test.mjs src/lib/lead-form.test.mjs scripts/smoke-tokens.test.mjs ../../scripts/check-pages-asset-paths.test.mjs && astro check",
    "test:e2e": "playwright test",
    "test:smoke": "node ./scripts/smoke-tokens.mjs",
    "test:pages-paths": "node ../../scripts/check-pages-asset-paths.mjs dist /"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "3.6.0",
    "@astrojs/tailwind": "^5.1.4",
    "@singleton-sd/tokens": "1.3.0",
    "astro": "^4.16.18",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49"
  }
}
